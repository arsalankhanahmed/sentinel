# --- Core ---
HTTP_ADDR=:8080
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel?sslmode=disable
PUBLIC_BASE_URL=https://platform.local          # deep links: https://platform.local/i/<token>
CORS_ORIGINS=http://localhost:5173
STATIC_DIR=                                     # set to frontend/dist to serve UI from the Go binary

# --- Security (REQUIRED in production) ---
# 32 random bytes, base64:  openssl rand -base64 32
MASTER_KEY=
# HS256 signing secret for API tokens (or swap middleware for your IdP JWKS)
JWT_SECRET=
AUTH_DISABLED=false                             # true ONLY for local development

# --- Engine tuning ---
WORKER_POOL_SIZE=32
WORKER_QUEUE_SIZE=1024
QUERY_TIMEOUT=60s
HEARTBEAT_INTERVAL=60s
PROBE_FAIL_THRESHOLD=2                          # consecutive failures before alerting (flap suppression)
LINK_TTL=720h                                   # deep-link validity (30 days)

# --- Email (SMTP, STARTTLS when offered) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=sentinel@platform.local
